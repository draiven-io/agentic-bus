# ===========================================================================
# Agentic Bus – Environment Variables
# ===========================================================================
# Copy this file to `.env` and fill in the values for your deployment.
# All variables have sensible defaults for local development.
# ===========================================================================

# ---------------------------------------------------------------------------
# Coordinator server
# ---------------------------------------------------------------------------

# WebSocket bind address and port
AGBUS_HOST=0.0.0.0
AGBUS_PORT=8765

# Admin REST API port (serves /api/admin/* endpoints for the dashboard UI)
AGBUS_API_PORT=8766

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AGBUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# LLM configuration is managed in the **database**, not in .env.
# Use the CLI to configure providers:
#
#   agbus llm add               # interactive wizard
#   agbus llm add --name my-openai --provider openai --model gpt-4o-mini \
#                 --api-key sk-... --activate
#   agbus llm list              # list all configurations
#   agbus llm activate <name>   # switch active provider
#   agbus llm show <name>       # show details
#   agbus llm update <name>     # update fields
#   agbus llm remove <name>     # delete a configuration
#
# The application CAN start without an LLM configured, but the admin
# must configure one before the bus can process intents.
#
# Supported providers: openai, anthropic, google, ollama, azure
#
# Environment variable fallbacks (used ONLY when no DB config exists):
# AGBUS_LLM_PROVIDER=openai
# AGBUS_LLM_MODEL=gpt-4o-mini
# AGBUS_LLM_TEMPERATURE=0.0
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# AGBUS_OLLAMA_BASE_URL=http://localhost:11434

# --- Azure OpenAI ------------------------------------------------------------
# pip install "agentic-bus[azure]"
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---------------------------------------------------------------------------
# OIDC Authentication
# ---------------------------------------------------------------------------

# OIDC issuer URL (e.g. https://accounts.google.com, https://your-keycloak/realms/agbus)
# Leave empty to use the DevVerifier (accepts any token – dev only)
# Require a bearer credential from every agent even without an IdP.
# With AGBUS_OIDC_ISSUER set this is implied and cannot be turned off.
AGBUS_REQUIRE_AGENT_AUTH=false

AGBUS_OIDC_ISSUER=

# Expected audience claim
AGBUS_OIDC_AUDIENCE=

# ---------------------------------------------------------------------------
# Admin Authorization
# ---------------------------------------------------------------------------
# Admins can approve/reject/revoke persistent agents and perform
# other administrative operations.  An identity is admin if:
#   1. Its OIDC `sub` is in AGBUS_ADMIN_SUBJECTS, OR
#   2. Its token carries the role AGBUS_ADMIN_ROLE inside the claim AGBUS_ADMIN_ROLE_CLAIM.

# Comma-separated list of OIDC subjects (sub claim) that are always admins.
# Example: "google-oauth2|123456,auth0|789012"
AGBUS_ADMIN_SUBJECTS=

# Role value that grants admin access (checked inside the role claim).
AGBUS_ADMIN_ROLE=agbus:admin

# Token claim key that contains the list of roles.
# Common values: "roles", "realm_access.roles" (Keycloak), "permissions" (Auth0)
AGBUS_ADMIN_ROLE_CLAIM=roles

# ---------------------------------------------------------------------------
# Agent connection
# ---------------------------------------------------------------------------

# WebSocket URI the agent SDK uses to reach the coordinator
AGBUS_COORDINATOR_URI=ws://localhost:8765

# ---------------------------------------------------------------------------
# Agent Persistence
# ---------------------------------------------------------------------------

# Database connection string (SQLAlchemy URL).
# Default: local SQLite file alongside the coordinator.
# Examples:
#   sqlite:///agbus_agents.db
#   postgresql://user:pass@localhost:5432/agbus
#   mysql+pymysql://user:pass@localhost/agbus
AGBUS_DATABASE_URL=sqlite:///agbus_agents.db

# Auto-approve persistent agent enrolments (true/false).
# When false, an admin must explicitly approve each agent.
AGBUS_AGENT_AUTO_APPROVE=false

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------

# OTLP exporter endpoint (when using a real collector instead of console)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name reported in traces
# OTEL_SERVICE_NAME=agentic-bus
